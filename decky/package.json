{
  "name": "lumux-decky",
  "version": "0.1.3",
  "description": "Philips Hue screen sync for SteamOS Game Mode, powered by Lumux",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Backend tests: python -m pytest tests (from the decky/ directory)\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjredondo/lumux.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "philips-hue",
    "ambilight"
  ],
  "author": "sjredondo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sjredondo/lumux/issues"
  },
  "homepage": "https://github.com/sjredondo/lumux/tree/main/decky#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
